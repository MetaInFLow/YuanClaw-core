# YuanClaw config template (first-time setup)
# Copy target: ~/.yuanclaw/config.yaml

agents:
  defaults:
    workspace: ~/.yuanclaw/workspace
    provider: openrouter
    model: anthropic/claude-opus-4-5
    temperature: 0.1
    maxTokens: 8192
    maxToolIterations: 40

providers:
  # Fill at least one provider key based on your chosen provider/model.
  openrouter:
    apiKey: ""
  openai:
    apiKey: ""
  anthropic:
    apiKey: ""

channels:
  telegram:
    enabled: false
    token: ""
    # Telegram user IDs. Keep empty list for no allowlist.
    allowFrom: []
    groupPolicy: mention

tools:
  restrictToWorkspace: true
  exec:
    timeout: 60
  web:
    search:
      # Optional: Brave Search key for web_search tool.
      apiKey: ""

gateway:
  host: 0.0.0.0
  port: 18790
