{
  "agents": {
    "defaults": {
      "workspace": "~/.yuanclaw/workspace",
      "provider": "openrouter",
      "model": "anthropic/claude-opus-4-5",
      "temperature": 0.1,
      "maxTokens": 8192,
      "maxToolIterations": 40
    }
  },
  "providers": {
    "openrouter": {
      "apiKey": ""
    },
    "openai": {
      "apiKey": ""
    },
    "anthropic": {
      "apiKey": ""
    }
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "token": "",
      "allowFrom": [],
      "groupPolicy": "mention"
    }
  },
  "tools": {
    "restrictToWorkspace": true,
    "exec": {
      "timeout": 60
    },
    "web": {
      "search": {
        "apiKey": ""
      }
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790
  }
}
