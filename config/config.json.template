{
  "agents": {
    "defaults": {
      "workspace": "~/.yuanclaw/workspace",
      "provider": "openrouter",
      "model": "anthropic/claude-opus-4-5",
      "temperature": 0.1,
      "maxTokens": 8192,
      "contextWindowTokens": 65536,
      "maxToolIterations": 40,
      "memoryWindow": 100,
      "memory": {
        "backend": "legacy",
        "dailyPages": true,
        "recentDays": 2,
        "searchMaxResults": 8,
        "extraPaths": []
      },
      "compaction": {
        "reserveTokensFloor": 12000,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 4000
        }
      }
    }
  },
  "providers": {
    "openrouter": {
      "apiKey": ""
    },
    "openai": {
      "apiKey": ""
    },
    "anthropic": {
      "apiKey": ""
    },
    "ollama": {
      "apiBase": "http://localhost:11434"
    },
    "mistral": {
      "apiKey": ""
    }
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "token": "",
      "allowFrom": ["*"],
      "groupPolicy": "mention"
    },
    "wecom": {
      "enabled": false,
      "botId": "",
      "secret": "",
      "allowFrom": ["*"],
      "welcomeMessage": ""
    }
  },
  "tools": {
    "restrictToWorkspace": true,
    "exec": {
      "timeout": 60
    },
    "web": {
      "search": {
        "provider": "brave",
        "baseUrl": "",
        "apiKey": "",
        "maxResults": 5
      }
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790
  }
}
